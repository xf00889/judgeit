# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application name displayed in UI and emails
APP_NAME="Beauty Pageant Judging System"

# Environment: local, staging, production
APP_ENV=local

# Application key (generate with: php artisan key:generate)
APP_KEY=

# Debug mode (set to false in production)
APP_DEBUG=true

# Application URL (update for production)
APP_URL=http://localhost

# Localization settings
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode settings
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP CLI server workers
PHP_CLI_SERVER_WORKERS=4

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Password hashing rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log channel: stack, single, daily, slack, syslog, errorlog
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# Log level: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=debug

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database connection type: mysql, sqlite, pgsql, sqlsrv
DB_CONNECTION=mysql

# MySQL/MariaDB Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beauty_pageant_judging
DB_USERNAME=root
DB_PASSWORD=

# Optional: Database socket connection (alternative to host/port)
# DB_SOCKET=

# Optional: Database charset and collation
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# Optional: SSL certificate for secure database connections
# MYSQL_ATTR_SSL_CA=

# SQLite Configuration (alternative to MySQL)
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite
# DB_FOREIGN_KEYS=true

# =============================================================================
# SESSION CONFIGURATION
# =============================================================================

# Session driver: file, cookie, database, memcached, redis, dynamodb, array
SESSION_DRIVER=database

# Session lifetime in minutes (120 = 2 hours)
SESSION_LIFETIME=120

# Encrypt session data
SESSION_ENCRYPT=false

# Session cookie path
SESSION_PATH=/

# Session cookie domain (null for current domain)
SESSION_DOMAIN=null

# =============================================================================
# BROADCASTING CONFIGURATION (Real-Time Updates)
# =============================================================================

# Broadcasting driver: log, pusher, redis, null
# - log: Development mode, logs events to laravel.log
# - pusher: Production mode with Pusher service (recommended)
# - redis: Self-hosted with Redis pub/sub
BROADCAST_CONNECTION=log

# Pusher Configuration (for production real-time updates)
# Sign up at https://pusher.com and create a Channels app
# Uncomment and configure these when using Pusher:
# PUSHER_APP_ID=your-app-id
# PUSHER_APP_KEY=your-app-key
# PUSHER_APP_SECRET=your-app-secret
# PUSHER_APP_CLUSTER=mt1

# Optional: Custom Pusher host (for self-hosted Pusher alternatives)
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https

# Redis Broadcasting Configuration (alternative to Pusher)
# Requires Laravel Echo Server or Soketi for WebSocket bridge
# BROADCAST_REDIS_CONNECTION=default

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Cache driver: file, database, redis, memcached, dynamodb, array
CACHE_STORE=database

# Optional: Cache key prefix
# CACHE_PREFIX=

# Memcached Configuration
MEMCACHED_HOST=127.0.0.1

# =============================================================================
# QUEUE CONFIGURATION
# =============================================================================

# Queue driver: sync, database, redis, sqs, beanstalkd, null
QUEUE_CONNECTION=database

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis client: phpredis, predis
REDIS_CLIENT=phpredis

# Redis connection settings
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Optional: Redis username (Redis 6+)
# REDIS_USERNAME=

# Optional: Redis database numbers
# REDIS_DB=0
# REDIS_CACHE_DB=1

# Optional: Redis cluster and prefix settings
# REDIS_CLUSTER=redis
# REDIS_PREFIX=beauty_pageant_judging_database_

# Optional: Redis persistent connections
# REDIS_PERSISTENT=false

# Optional: Redis URL (alternative to individual settings)
# REDIS_URL=redis://localhost:6379

# =============================================================================
# FILESYSTEM CONFIGURATION
# =============================================================================

# Default filesystem disk: local, public, s3
FILESYSTEM_DISK=local

# =============================================================================
# MAIL CONFIGURATION
# =============================================================================

# Mail driver: smtp, sendmail, mailgun, ses, postmark, log, array
MAIL_MAILER=log

# SMTP Configuration (when using smtp mailer)
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# Mail from address and name
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# AWS CONFIGURATION (Optional)
# =============================================================================

# AWS credentials (for S3 storage, SES email, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# VITE CONFIGURATION (Frontend Build Tool)
# =============================================================================

# These variables are exposed to the frontend JavaScript
VITE_APP_NAME="${APP_NAME}"

# Pusher configuration for frontend (must match backend settings)
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Optional: Custom Pusher host for frontend
# VITE_PUSHER_HOST="${PUSHER_HOST}"
# VITE_PUSHER_PORT="${PUSHER_PORT}"
# VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

# =============================================================================
# PAGEANT-SPECIFIC SETTINGS (Optional Custom Configuration)
# =============================================================================

# Default number of contestants per pageant
# PAGEANT_DEFAULT_CONTESTANTS=10

# Maximum score value for criteria
# PAGEANT_MAX_CRITERION_SCORE=100

# Enable audit logging for admin actions
# PAGEANT_AUDIT_LOGGING=true

# Real-time update polling interval (milliseconds, fallback when WebSocket fails)
# PAGEANT_POLLING_INTERVAL=10000

# Session timeout warning (minutes before expiration)
# PAGEANT_SESSION_WARNING=5

